<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tenant isolation: Payouts -->
        <record id="vin_payout_tenant_rule" model="ir.rule">
            <field name="name">VIN Payout — Tenant Isolation</field>
            <field name="model_id" ref="model_vin_payout"/>
            <field name="domain_force">[('tenant_id.member_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Tenant isolation: Payment Events -->
        <record id="vin_payment_event_tenant_rule" model="ir.rule">
            <field name="name">VIN Payment Event — Tenant Isolation</field>
            <field name="model_id" ref="model_vin_payment_event"/>
            <field name="domain_force">[('tenant_id.member_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Tenant isolation: Payment Provider -->
        <record id="vin_payment_provider_tenant_rule" model="ir.rule">
            <field name="name">VIN Payment Provider — Tenant Isolation</field>
            <field name="model_id" ref="model_vin_payment_provider"/>
            <field name="domain_force">[('tenant_id.member_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Tenant isolation: Webhook Logs -->
        <record id="vin_webhook_log_tenant_rule" model="ir.rule">
            <field name="name">VIN Webhook Log — Tenant Isolation</field>
            <field name="model_id" ref="model_vin_webhook_log"/>
            <field name="domain_force">[('tenant_id.member_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
