<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record Rule: Organization Tenant Scoping -->
        <record id="rule_vin_organization_tenant_isolation" model="ir.rule">
            <field name="name">VIN Organization: Tenant Scoped Access</field>
            <field name="model_id" ref="model_vin_organization"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[
                '|',
                ('tenant_id.organization_ids.membership_ids.user_id', '=', user.id),
                ('tenant_id.organization_ids.membership_ids.user_id', '=', False)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rule: Legal Entity Isolation -->
        <record id="rule_vin_legal_entity_tenant_isolation" model="ir.rule">
            <field name="name">VIN Legal Entity: Tenant Scoped Access</field>
            <field name="model_id" ref="model_vin_legal_entity"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[
                ('organization_id.membership_ids.user_id', '=', user.id)
            ]</field>
        </record>

        <!-- Record Rule: Master Project Isolation -->
        <record id="rule_vin_master_project_tenant_isolation" model="ir.rule">
            <field name="name">VIN Master Project: Organization &amp; Tenant Isolation</field>
            <field name="model_id" ref="model_vin_master_project"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[
                ('organization_id.membership_ids.user_id', '=', user.id)
            ]</field>
        </record>
    </data>
</odoo>
