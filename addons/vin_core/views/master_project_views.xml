<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vin_master_project_tree" model="ir.ui.view">
        <field name="name">vin.master.project.tree</field>
        <field name="model">vin.master.project</field>
        <field name="arch" type="xml">
            <tree string="Master Projects">
                <field name="name"/>
                <field name="organization_id"/>
                <field name="reporting_currency_id"/>
                <field name="state"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_vin_master_project_form" model="ir.ui.view">
        <field name="name">vin.master.project.form</field>
        <field name="model">vin.master.project</field>
        <field name="arch" type="xml">
            <form string="Master Project Root">
                <header>
                    <button name="action_verify_and_complete" type="object" string="Verify &amp; Complete (14-Day Window)" states="acceptance,financial_close" class="btn-primary"/>
                    <button name="action_finalize_closure" type="object" string="Finalize Project Closure" states="completed" class="btn-success"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,matching,contracting,execution,acceptance,completed,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Project Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="organization_id"/>
                            <field name="reporting_currency_id"/>
                        </group>
                        <group>
                            <field name="uuid"/>
                            <field name="brief_version_id"/>
                            <field name="completed_at" attrs="{'invisible': [('completed_at', '=', False)]}"/>
                            <field name="final_closure_deadline" attrs="{'invisible': [('final_closure_deadline', '=', False)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="5-Gate System Closure Checklist">
                            <group>
                                <field name="gate_workstreams_complete"/>
                                <field name="gate_escrow_zero_out"/>
                                <field name="gate_ip_transfer_complete"/>
                                <field name="gate_tax_invoice_reconciled"/>
                                <field name="gate_no_active_dispute"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_vin_master_project" model="ir.actions.act_window">
        <field name="name">Master Projects</field>
        <field name="res_model">vin.master.project</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_vin_projects" name="Projects" parent="menu_vin_root" sequence="20"/>
    <menuitem id="menu_vin_master_project" name="Master Projects" parent="menu_vin_projects" action="action_vin_master_project" sequence="10"/>
</odoo>
