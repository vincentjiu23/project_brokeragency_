<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Public Peer Review Views -->
    <record id="view_vin_review_tree" model="ir.ui.view">
        <field name="name">vin.review.tree</field>
        <field name="model">vin.review</field>
        <field name="arch" type="xml">
            <tree string="Peer Reviews" decoration-info="state == 'sealed'" decoration-success="state == 'revealed'" decoration-warning="state == 'flagged'" decoration-danger="state == 'redacted'">
                <field name="contract_id"/>
                <field name="reviewer_organization_id"/>
                <field name="reviewee_partner_id"/>
                <field name="reviewee_organization_id"/>
                <field name="review_direction"/>
                <field name="overall_rating"/>
                <field name="quality_rating"/>
                <field name="timeliness_rating"/>
                <field name="communication_rating"/>
                <field name="state" widget="badge"/>
                <field name="revealed_at"/>
            </tree>
        </field>
    </record>

    <record id="view_vin_review_form" model="ir.ui.view">
        <field name="name">vin.review.form</field>
        <field name="model">vin.review</field>
        <field name="arch" type="xml">
            <form string="Peer Review">
                <header>
                    <button name="action_flag_for_moderation" string="Flag for Moderation" type="object" class="btn-warning" invisible="state in ['flagged', 'redacted']"/>
                    <button name="action_redact" string="Redact Review" type="object" class="btn-danger" invisible="state == 'redacted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="sealed,revealed,flagged,redacted"/>
                </header>
                <sheet>
                    <group>
                        <group string="Contract &amp; Parties">
                            <field name="tenant_id"/>
                            <field name="contract_id"/>
                            <field name="project_id"/>
                            <field name="reviewer_organization_id"/>
                            <field name="reviewee_partner_id"/>
                            <field name="reviewee_organization_id"/>
                            <field name="review_direction"/>
                        </group>
                        <group string="Ratings (1–5 Stars)">
                            <field name="overall_rating"/>
                            <field name="quality_rating"/>
                            <field name="communication_rating"/>
                            <field name="timeliness_rating"/>
                            <field name="professionalism_rating"/>
                            <field name="value_rating"/>
                        </group>
                    </group>
                    <group string="Written Feedback">
                        <field name="public_comment" placeholder="Public feedback displayed on profile upon dual-blind reveal..."/>
                        <field name="private_feedback" placeholder="Confidential feedback for platform operators only..."/>
                    </group>
                    <group string="Dual-Blind Sealing &amp; Digital Hash">
                        <group>
                            <field name="counterpart_review_id" readonly="1"/>
                            <field name="revealed_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="sha256_hash" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Reputation Score Aggregate Views -->
    <record id="view_vin_reputation_score_tree" model="ir.ui.view">
        <field name="name">vin.reputation.score.tree</field>
        <field name="model">vin.reputation.score</field>
        <field name="arch" type="xml">
            <tree string="Reputation Scores">
                <field name="display_name"/>
                <field name="partner_profile_id"/>
                <field name="organization_id"/>
                <field name="public_avg_rating"/>
                <field name="total_reviews_received"/>
                <field name="total_projects_completed"/>
                <field name="on_time_delivery_rate"/>
                <field name="internal_trust_score"/>
                <field name="trust_tier" widget="badge"/>
                <field name="last_recalculated_at"/>
            </tree>
        </field>
    </record>

    <record id="view_vin_reputation_score_form" model="ir.ui.view">
        <field name="name">vin.reputation.score.form</field>
        <field name="model">vin.reputation.score</field>
        <field name="arch" type="xml">
            <form string="Reputation Score Profile">
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Entity Reputation</span>
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group>
                        <group string="Subject">
                            <field name="tenant_id"/>
                            <field name="partner_profile_id"/>
                            <field name="organization_id"/>
                        </group>
                        <group string="Internal Trust (Hidden From Public API)">
                            <field name="internal_trust_score"/>
                            <field name="trust_tier" widget="badge"/>
                            <field name="trust_events_count"/>
                            <field name="last_recalculated_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Public Review Aggregates">
                            <group>
                                <group string="Average Ratings">
                                    <field name="public_avg_rating"/>
                                    <field name="public_quality_avg"/>
                                    <field name="public_communication_avg"/>
                                    <field name="public_timeliness_avg"/>
                                    <field name="public_professionalism_avg"/>
                                    <field name="public_value_avg"/>
                                </group>
                                <group string="Fulfillment Performance">
                                    <field name="total_reviews_received"/>
                                    <field name="total_projects_completed"/>
                                    <field name="on_time_delivery_rate"/>
                                    <field name="first_submission_acceptance_rate"/>
                                    <field name="repeat_client_rate"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Internal Trust Events Views (Read-Only) -->
    <record id="view_vin_trust_event_tree" model="ir.ui.view">
        <field name="name">vin.trust.event.tree</field>
        <field name="model">vin.trust.event</field>
        <field name="arch" type="xml">
            <tree string="Trust Scoring Events" create="false" edit="false" delete="false">
                <field name="event_date"/>
                <field name="subject_partner_id"/>
                <field name="subject_organization_id"/>
                <field name="event_category"/>
                <field name="event_type"/>
                <field name="score_delta"/>
                <field name="contract_id"/>
                <field name="milestone_id"/>
            </tree>
        </field>
    </record>

    <record id="view_vin_trust_event_form" model="ir.ui.view">
        <field name="name">vin.trust.event.form</field>
        <field name="model">vin.trust.event</field>
        <field name="arch" type="xml">
            <form string="Trust Scoring Event" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="Event Classification">
                            <field name="tenant_id"/>
                            <field name="event_category"/>
                            <field name="event_type"/>
                            <field name="score_delta"/>
                            <field name="weight"/>
                            <field name="event_date"/>
                        </group>
                        <group string="Subject &amp; Scope">
                            <field name="subject_partner_id"/>
                            <field name="subject_organization_id"/>
                            <field name="contract_id"/>
                            <field name="milestone_id"/>
                            <field name="related_entity"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Detailed internal audit notes for this trust event..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_vin_review" model="ir.actions.act_window">
        <field name="name">Peer Reviews</field>
        <field name="res_model">vin.review</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_vin_reputation_score" model="ir.actions.act_window">
        <field name="name">Reputation Scores</field>
        <field name="res_model">vin.reputation.score</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_vin_trust_event" model="ir.actions.act_window">
        <field name="name">Internal Trust Events</field>
        <field name="res_model">vin.trust.event</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_vin_reputation_root" name="Reputation &amp; Trust" parent="vin_core.menu_vin_core_root" sequence="100"/>
    <menuitem id="menu_vin_review_sub" name="Peer Reviews" parent="menu_vin_reputation_root" action="action_vin_review" sequence="10"/>
    <menuitem id="menu_vin_reputation_score_sub" name="Reputation Scores" parent="menu_vin_reputation_root" action="action_vin_reputation_score" sequence="20"/>
    <menuitem id="menu_vin_trust_event_sub" name="Trust Events (Internal)" parent="menu_vin_reputation_root" action="action_vin_trust_event" sequence="30"/>
</odoo>
