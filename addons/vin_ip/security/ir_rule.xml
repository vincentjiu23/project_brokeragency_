<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-Tenancy Record Rules for IP Assignments & Portfolio Grants -->
        <record id="rule_vin_ip_assignment_tenant_isolation" model="ir.rule">
            <field name="name">VIN IP Assignment: Tenant Isolation</field>
            <field name="model_id" ref="model_vin_ip_assignment"/>
            <field name="domain_force">['|', ('tenant_id', '=', False), ('tenant_id', '=', user.tenant_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_vin_portfolio_display_grant_tenant_isolation" model="ir.rule">
            <field name="name">VIN Portfolio Display Grant: Tenant Isolation</field>
            <field name="model_id" ref="model_vin_portfolio_display_grant"/>
            <field name="domain_force">['|', ('tenant_id', '=', False), ('tenant_id', '=', user.tenant_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
