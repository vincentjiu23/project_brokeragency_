<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Contract Tenant Isolation -->
        <record id="rule_vin_contract_tenant" model="ir.rule">
            <field name="name">Contract: Tenant Isolation</field>
            <field name="model_id" ref="model_vin_contract"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[
                '|',
                ('tenant_id.organization_ids.membership_ids.user_id', '=', user.id),
                ('partner_profile_id.partner_id.user_ids', 'in', [user.id])
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Contract Proposal Isolation -->
        <record id="rule_vin_contract_proposal_tenant" model="ir.rule">
            <field name="name">Contract Proposal: Tenant &amp; Participant Isolation</field>
            <field name="model_id" ref="model_vin_contract_proposal"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[
                '|',
                ('tenant_id.organization_ids.membership_ids.user_id', '=', user.id),
                ('contract_id.partner_profile_id.partner_id.user_ids', 'in', [user.id])
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Contract Change Request Isolation -->
        <record id="rule_vin_contract_change_request_tenant" model="ir.rule">
            <field name="name">Change Request: Tenant &amp; Participant Isolation</field>
            <field name="model_id" ref="model_vin_contract_change_request"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[
                '|',
                ('tenant_id.organization_ids.membership_ids.user_id', '=', user.id),
                ('contract_id.partner_profile_id.partner_id.user_ids', 'in', [user.id])
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
