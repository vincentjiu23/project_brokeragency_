<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Workstream Tenant Isolation -->
        <record id="rule_vin_workstream_tenant" model="ir.rule">
            <field name="name">Workstream: Tenant &amp; Contract Isolation</field>
            <field name="model_id" ref="model_vin_workstream"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[
                '|',
                ('tenant_id.organization_ids.membership_ids.user_id', '=', user.id),
                ('contract_id.partner_profile_id.partner_id.user_ids', 'in', [user.id])
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Milestone Tenant Isolation -->
        <record id="rule_vin_milestone_tenant" model="ir.rule">
