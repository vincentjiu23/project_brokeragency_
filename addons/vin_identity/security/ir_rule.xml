<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Identity Link: Users can only see their own link -->
        <record id="rule_vin_identity_link_user_own" model="ir.rule">
            <field name="name">VIN Identity Link: Own Record</field>
            <field name="model_id" ref="model_vin_identity_link"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Verification Case: Users can only see their own KYC/KYB records -->
        <record id="rule_vin_identity_verification_user_own" model="ir.rule">
            <field name="name">VIN Identity Verification: Own Record Only</field>
            <field name="model_id" ref="model_vin_identity_verification"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
