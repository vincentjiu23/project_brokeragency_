<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-Tenancy Record Rules for Integration Domain -->
        <record id="rule_vin_integration_endpoint_tenant_isolation" model="ir.rule">
            <field name="name">VIN Integration Endpoint: Tenant Isolation</field>
            <field name="model_id" ref="model_vin_integration_endpoint"/>
            <field name="domain_force">['|', ('tenant_id', '=', False), ('tenant_id', '=', user.tenant_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_vin_dlq_message_tenant_isolation" model="ir.rule">
            <field name="name">VIN DLQ Message: Tenant Isolation</field>
            <field name="model_id" ref="model_vin_dlq_message"/>
            <field name="domain_force">['|', ('tenant_id', '=', False), ('tenant_id', '=', user.tenant_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_vin_event_replay_log_tenant_isolation" model="ir.rule">
            <field name="name">VIN Event Replay Log: Tenant Isolation</field>
            <field name="model_id" ref="model_vin_event_replay_log"/>
            <field name="domain_force">['|', ('tenant_id', '=', False), ('tenant_id', '=', user.tenant_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
