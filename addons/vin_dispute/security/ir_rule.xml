<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-Tenancy Record Rules for Dispute & Arbitration -->
        <record id="rule_vin_dispute_tenant_isolation" model="ir.rule">
            <field name="name">VIN Dispute: Tenant Isolation</field>
            <field name="model_id" ref="model_vin_dispute"/>
            <field name="domain_force">['|', ('tenant_id', '=', False), ('tenant_id', '=', user.tenant_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_vin_dispute_evidence_tenant_isolation" model="ir.rule">
            <field name="name">VIN Dispute Evidence: Tenant Isolation</field>
            <field name="model_id" ref="model_vin_dispute_evidence"/>
            <field name="domain_force">['|', ('tenant_id', '=', False), ('tenant_id', '=', user.tenant_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_vin_arbitration_case_tenant_isolation" model="ir.rule">
            <field name="name">VIN Arbitration Case: Tenant Isolation</field>
            <field name="model_id" ref="model_vin_arbitration_case"/>
            <field name="domain_force">['|', ('tenant_id', '=', False), ('tenant_id', '=', user.tenant_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
